<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aquasentinel.presentation.controller.SamplesController"
      spacing="16">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Top Action Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Water Quality Samples" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -aq-text-primary;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Register Sample" styleClass="btn-secondary" onAction="#handleRegisterSample"/>
        <Button text="Record Readings &amp; Submit" styleClass="btn-secondary" onAction="#handleRecordReadings"/>
        <Button text="⚡ Evaluate against Profile" styleClass="btn-primary" onAction="#handleEvaluateSample"/>
    </HBox>

    <!-- Samples Table -->
    <TableView fx:id="tableSamples" VBox.vgrow="ALWAYS" styleClass="card">
        <columns>
            <TableColumn fx:id="colCode" text="Sample Code" prefWidth="140"/>
            <TableColumn fx:id="colSource" text="Target Water Source" prefWidth="250"/>
            <TableColumn fx:id="colCollected" text="Collection Timestamp" prefWidth="190"/>
            <TableColumn fx:id="colStatus" text="Lifecycle Status" prefWidth="140"/>
            <TableColumn fx:id="colOrigin" text="Origin" prefWidth="140"/>
        </columns>
    </TableView>

    <!-- Bottom summary -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblSampleCount" text="Showing samples" styleClass="empty-state-text"/>
    </HBox>
</VBox>
